# ===========================================
# Monolith — переменные окружения
# Скопируй в .env и заполни нужные значения:
#   cp .env.example .env
# Запуск: source .env && ../gradlew :monolith:bootRun
# ===========================================

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mydatabase?currentSchema=monolit_schema
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=mypassword

# -------------------------------------------
# Server
# -------------------------------------------
SERVER_PORT=8080

# -------------------------------------------
# JWT
# -------------------------------------------
JWT_ISSUER=http://localhost:8080
JWT_ACCESS_TOKEN_TTL=900        # секунды (15 мин)
JWT_REFRESH_TOKEN_TTL=2592000   # секунды (30 дней)

# -------------------------------------------
# Cookie
# -------------------------------------------
COOKIE_SECURE=false             # true в проде (HTTPS)
COOKIE_SAME_SITE=Lax            # None для cross-origin

# -------------------------------------------
# OAuth2 — Yandex
# https://oauth.yandex.ru/client/new
# -------------------------------------------
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# -------------------------------------------
# OAuth2 — GitHub
# https://github.com/settings/developers
# -------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------
# Frontend / redirect URLs
# -------------------------------------------
APP_FRONTEND_URL=http://localhost:5173
APP_OAUTH2_REDIRECT_BASE_URL=http://localhost:8080

# ===========================================
# Для прода (SPRING_PROFILES_ACTIVE=prod)
# ===========================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/proddb?currentSchema=monolit_schema
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None
# JWT_ISSUER=https://api.yourdomain.com
# APP_FRONTEND_URL=https://yourdomain.com
# APP_OAUTH2_REDIRECT_BASE_URL=https://api.yourdomain.com
