KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=llm-worker
KAFKA_GROUP_ID_BATCHES=llm-worker-batches
KAFKA_GROUP_ID_AUDIO=llm-worker-audio
KAFKA_GROUP_ID_MEETING_AUDIO=llm-worker-meeting-audio
KAFKA_GROUP_ID_LIFECYCLE=llm-worker-lifecycle

# Ollama (local) — по умолчанию
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHEAP_MODEL=mistral
LLM_EXPENSIVE_MODEL=llama3.1:8b

# Или OpenAI
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_CHEAP_MODEL=gpt-4o-mini
# LLM_EXPENSIVE_MODEL=gpt-4o

# Cloud embeddings (OpenAI-compatible)
EMBEDDINGS_API_BASE=https://api.openai.com/v1
EMBEDDINGS_API_KEY=sk-...
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

QDRANT_URL=http://localhost:6333
DEDUP_THRESHOLD=0.92
CLASSIFIER_THRESHOLD=0.65

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

WHISPER_API_BASE=http://localhost:8002/v1
WHISPER_API_KEY=dummy
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_LANGUAGE=ru
WHISPER_TIMEOUT_SECONDS=120

# ── Голосовой ассистент (voice Q&A) ──
# Backend для tools доски (роль BOT через X-Bot-Secret)
BACKEND_URL=http://localhost:8080
BOT_SECRET=changeme
# LLM для голоса (пусто → LLM_CHEAP_MODEL). Нужна модель с tool-calling.
VOICE_LLM_MODEL=
# TTS через OpenRouter /audio/speech (ключ пуст → берётся LLM_API_KEY)
TTS_API_BASE=https://openrouter.ai/api/v1
TTS_API_KEY=
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=Ara
TTS_FORMAT=mp3
TTS_TIMEOUT_SECONDS=30
