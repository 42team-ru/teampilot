KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=llm-worker

# Ollama (local) — по умолчанию
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHEAP_MODEL=mistral
LLM_EXPENSIVE_MODEL=llama3.1:8b

# Или OpenAI
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_CHEAP_MODEL=gpt-4o-mini
# LLM_EXPENSIVE_MODEL=gpt-4o

# FastEmbed — модель скачается автоматически (~60 MB)
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

QDRANT_URL=http://localhost:6333
DEDUP_THRESHOLD=0.92
CLASSIFIER_THRESHOLD=0.65

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
