BACKEND_URL=http://localhost:8080
BOT_SECRET=changeme
CHUNK_SECONDS=10
SAMPLE_RATE=16000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=audio
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# CHUNKS_DEBUG_DIR=/tmp/telemost-chunks

# ── Голосовой Q&A («Пилот, ...») ──
VOICE_QA_ENABLED=true
WORKER_URL=http://localhost:8001
# STT для wake-детекта + вопроса (Groq, тот же ключ, что в llm-worker/.env)
WHISPER_API_BASE=https://api.groq.com/openai/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=ru
WAKE_WORDS=пилот,pilot
# Режим триггера: stt (Whisper на каждую фразу) | openwakeword (локальный движок, без сети)
WAKE_MODE=stt
# openWakeWord: путь к кастомной модели «пилот».onnx (пусто → встроенные, для теста say "hey jarvis")
OWW_MODEL_PATH=
OWW_THRESHOLD=0.5
OWW_INFERENCE_FRAMEWORK=onnx
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=700
MIN_UTTERANCE_MS=600
MAX_UTTERANCE_MS=12000
VOICE_REPLY_TIMEOUT_SECONDS=25
