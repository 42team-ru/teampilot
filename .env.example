# Правило: здесь только базовые значения (секреты, URL, порты).
# Spring Boot переменные (SPRING_*, APP_*) конструируются в docker-compose — не дублируй их сюда.

# ==========================================
# Database
# ==========================================
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase
DB_PORT=5432

# ==========================================
# S3 / MinIO
# ==========================================
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_SERVER_URL=https://s3.42team.ru
S3_CONSOLE_URL=https://minio.42team.ru
S3_DEFAULT_BUCKET=uploads
# Публичный URL MinIO для presigned download-ссылок (что увидит браузер пользователя).
# В dev: http://<IP-сервера>:9000 ; в prod с Caddy: https://s3.42team.ru
S3_PRESIGNED_ENDPOINT=http://localhost:9000

# ==========================================
# OAuth2
# ==========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ==========================================
# Ports
# ==========================================
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8082

# ==========================================
# Spring
# ==========================================
SPRING_PROFILES_ACTIVE=prod

# ==========================================
# Grafana
# ==========================================
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# ==========================================
# Redpanda Console — Basic Auth (через Caddy)
# Хэш: docker run --rm caddy caddy hash-password --plaintext "пароль"
# ==========================================
REDPANDA_CONSOLE_USER=admin
REDPANDA_CONSOLE_PASSWORD_HASH=
