# Правило: здесь только базовые значения (секреты, URL, порты).
# Spring Boot переменные (SPRING_*, APP_*, S3_ENDPOINT и т.п.) конструируются
# в docker-compose из этих значений — не дублируй их сюда.

# ==========================================
# Database
# ==========================================
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase
DB_PORT=5432

# ==========================================
# S3 / MinIO
# ==========================================
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_DEFAULT_BUCKET=uploads
# Публичный URL S3 API (presigned-ссылки, MinIO MINIO_SERVER_URL)
S3_SERVER_URL=https://s3.42team.ru
# URL веб-консоли MinIO
S3_CONSOLE_URL=https://minio.42team.ru

# ==========================================
# OAuth2 (опционально)
# ==========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ==========================================
# Ports
# ==========================================
API_GATEWAY_PORT=8080

# ==========================================
# Spring
# ==========================================
SPRING_PROFILES_ACTIVE=prod

# ==========================================
# Grafana
# ==========================================
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# ==========================================
# Redpanda Console — Basic Auth (через Caddy)
# Хэш: docker run --rm caddy caddy hash-password --plaintext "пароль"
# ==========================================
REDPANDA_CONSOLE_USER=admin
REDPANDA_CONSOLE_PASSWORD_HASH=

# ==========================================
# YooMoney (YooKassa)
# Взять в личном кабинете: yookassa.ru → Интеграция → API ключи
# ==========================================
YOOKASSA_SHOP_ID=<your-shop-id>
YOOKASSA_SECRET_KEY=<your-secret-key>
YOOKASSA_RETURN_URL=https://t.me/prorab_bot
# Через русский прокси-VPS (иначе api.yookassa.ru блокирует нероссийские IP)
YOOKASSA_API_URL=https://yookassa-proxy.42team.ru/v3

# IP русского VPS для make yk-proxy-* команд
YK_PROXY_HOST=93.77.167.53

# ==========================================
# Telegram Bot / Monolith
# ==========================================
BOT_TOKEN=<your-telegram-bot-token>
BOT_SECRET=changeme
BOT_URL=t.me/prorab_bot
APP_JWT_SECRET=bXlfc3VwZXJfc2VjcmV0X2tleV9mb3JfaGFja2F0aG9uXzIwMjQ=
MOCK_YOUGILE=true
MINIO_BUCKET_AUDIO=audio-recordings
DEBUG_MODE=false
DEBUG_ADMIN_IDS=[]

# ==========================================
# LLM Worker
# ==========================================
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=<your-openrouter-or-openai-api-key>
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_EXPENSIVE_MODEL=openai/gpt-4.1-mini

EMBEDDINGS_API_BASE=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=<your-embeddings-api-key>
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

WHISPER_API_BASE=https://api.groq.com/openai/v1
WHISPER_API_KEY=<your-groq-api-key>
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=ru
WHISPER_TIMEOUT_SECONDS=120

CLASSIFIER_THRESHOLD=0.65
AUTO_CONFIRM_THRESHOLD=0.90
DEDUP_THRESHOLD=0.92
STATUS_HINT_THRESHOLD=0.25
LLM_WORKER_CONCURRENCY=4
TRANSCRIPT_CHUNK_CHARS=6000
TRANSCRIPT_CHUNK_OVERLAP_CHARS=500
MEETING_CONTEXT_CHARS=6000
MEETING_EXTRACTION_MIN_CHARS=100
MEETING_EXTRACTION_STEP_CHARS=200
MEETING_FINALIZE_WAIT_SECONDS=10
