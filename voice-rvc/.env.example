# voice-rvc — конфигурация сервиса

# Устройство для RVC-инференса: cpu | cpu:0 | cuda:0
RVC_DEVICE=cpu:0

# Базовый нейтральный голос edge-tts (русский). Список: `edge-tts --list-voices`
BASE_TTS_VOICE=ru-RU-DmitryNeural

# Алгоритм извлечения F0 для RVC: rmvpe (лучший) | harvest | crepe | pm
RVC_F0METHOD=rmvpe

# Доля смешивания с index-файлом (0..1): больше — ближе к тембру модели
RVC_INDEX_RATE=0.75

# Защита глухих согласных/дыхания (0..0.5)
RVC_PROTECT=0.33

# Транспонирование в полутонах (0 — без сдвига; +12 мужской→женский и т.п.)
RVC_F0UP_KEY=0

# HTTP-порт сервиса
PORT=5050
